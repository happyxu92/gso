FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
# The minimal Ubuntu image does not contain CA certificates yet, so bootstrap
# APT over HTTP. Ubuntu repository metadata and packages remain GPG-verified.
ARG UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu
ARG PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ENV TZ=Asia/Shanghai

# Use the Aliyun Ubuntu mirror.
RUN sed -Ei \
        "s#https?://(archive|security)\\.ubuntu\\.com/ubuntu/?#${UBUNTU_MIRROR}/#g" \
        /etc/apt/sources.list
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    git \
    build-essential \
    ccache \
    libffi-dev \
    libtiff-dev \
    python3 \
    python3-dev \
    python3-pip \
    python-is-python3 \
    jq \
    curl \
    locales \
    locales-all \
    tzdata \
    gcc \
    g++ \
    gfortran \
    libopenblas-dev \
    liblapack-dev \
    pkg-config \
    libssl-dev \
    clang \
    llvm \
    libtiff5-dev \
    libjpeg8-dev \
    libopenjp2-7-dev \
    zlib1g-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libwebp-dev \
    tcl8.6-dev \
    tk8.6-dev \
    python3-tk \
    libharfbuzz-dev \
    libfribidi-dev \
    libxcb1-dev \
    libx11-dev \
    && install -d /tools/llvm/bin \
    && ln -sf "$(command -v llvm-ar)" /tools/llvm/bin/llvm-ar \
    && test -f /usr/include/python3.10/Python.h \
    && test -x /tools/llvm/bin/llvm-ar \
    && rm -rf /var/lib/apt/lists/*

# Use the official Miniconda installer repository by default.
ARG MINICONDA_MIRROR=https://repo.anaconda.com/miniconda
ARG MINICONDA_INSTALLER=Miniconda3-py312_26.5.3-2-Linux-x86_64.sh

# Install Python 3.12 through Miniconda and remove the installer afterward.
RUN wget --progress=dot:giga \
        "${MINICONDA_MIRROR}/${MINICONDA_INSTALLER}" \
        -O "/tmp/${MINICONDA_INSTALLER}" \
    && bash "/tmp/${MINICONDA_INSTALLER}" -b -p /opt/miniconda3 \
    && rm -f "/tmp/${MINICONDA_INSTALLER}"
ENV PATH=/opt/miniconda3/bin:$PATH
RUN conda init --all \
    && conda config --append channels conda-forge

# Install uv from the Aliyun PyPI mirror and retain the mirror settings for
# downstream pip/uv commands in task images.
ENV PIP_INDEX_URL=${PYPI_INDEX_URL} \
    UV_INDEX_URL=${PYPI_INDEX_URL}
RUN python -m pip install --no-cache-dir uv==0.5.4

RUN adduser --disabled-password --gecos 'dog' nonroot

WORKDIR /testbed/

# Fail the build if architecture or tool versions are incorrect.
RUN test "$(uname -m)" = "x86_64" \
    && python --version \
    && uv --version
